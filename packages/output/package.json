{
  "name": "@picklist/output",
  "version": "1.0.0",
  "description": "Output generation utilities for Picklist data pipeline",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@picklist/types": "*",
    "@picklist/filter": "*",
    "consola": "^3.2.3"
  },
  "devDependencies": {
    "typescript": "*",
    "vitest": "*",
    "@types/node": "^22.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ]
}
