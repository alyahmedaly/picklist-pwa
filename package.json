{
  "name": "picklist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "vite build",
    "build:workspaces": "npm run build --workspaces",
    "test:workspaces": "npm run test --workspaces",
    "lint": "eslint .",
    "preview": "vite preview",
    "pretest": "node scripts/build-integration-fixture.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "transform": "node src/scripts/transform-data.ts --input tests/fixtures/sample-small.csv --outDir out-test",
    "transform:production": "node src/scripts/transform-data.ts --input data/2024-10-23.csv --outDir public",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:a11y": "npm run build-storybook && npx serve storybook-static -l 6008 & sleep 5 && npx test-storybook --url http://localhost:6008 --failOnConsole; kill %1",
    "test:a11y:ci": "npm run build-storybook && npx serve storybook-static -l 6008 & SERVER_PID=$! && sleep 5 && npx test-storybook --url http://localhost:6008 --failOnConsole --ci && kill $SERVER_PID",
    "test:a11y:detailed": "npm run build-storybook && npx serve storybook-static -l 6008 & sleep 5 && npx test-storybook --url http://localhost:6008 --verbose; kill %1",
    "knip": "knip"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6",
    "@std/csv": "npm:@jsr/std__csv@^1.0.6",
    "@tanstack/react-virtual": "^3.13.12",
    "cac": "^6.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "kysely": "^0.28.7",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.9.2",
    "recharts": "^3.2.1",
    "stream-json": "^1.9.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@chromatic-com/storybook": "^4.1.1",
    "@eslint/js": "^9.33.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@storybook/addon-a11y": "^9.1.7",
    "@storybook/addon-docs": "^9.1.7",
    "@storybook/addon-onboarding": "^9.1.7",
    "@storybook/addon-vitest": "^9.1.7",
    "@storybook/react": "^9.1.8",
    "@storybook/react-vite": "^9.1.7",
    "@storybook/test-runner": "^0.23.0",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.17",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "@vitest/browser": "3.2.4",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "^9.1.7",
    "globals": "^16.3.0",
    "jsdom": "^27.0.0",
    "knip": "^5.64.0",
    "prettier": "3.6.2",
    "shadcn": "^3.3.1",
    "storybook": "^9.1.7",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.3.8",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "vitest-axe": "^0.1.0",
    "workbox-window": "^7.3.0"
  }
}
