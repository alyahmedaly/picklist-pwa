{
  "name": "UI Formatter Contract",
  "version": "1.0.0",
  "description": "Contract for transforming Product data to UI-optimized format",
  "functions": {
    "formatProductForUI": {
      "description": "Transform Product to UIOptimizedProduct format",
      "input": {
        "type": "object",
        "properties": {
          "product": {
            "$ref": "#/definitions/Product"
          },
          "options": {
            "type": "object",
            "properties": {
              "currency": {
                "type": "string",
                "default": "EUR",
                "description": "Currency code for price formatting"
              },
              "locale": {
                "type": "string",
                "default": "nl-NL",
                "description": "Locale for number formatting"
              }
            }
          }
        },
        "required": ["product"]
      },
      "output": {
        "$ref": "#/definitions/UIOptimizedProduct"
      },
      "errors": ["INVALID_PRODUCT_DATA", "TRANSFORMATION_FAILED"]
    },
    "formatCategoryTree": {
      "description": "Transform flat category array to hierarchical tree",
      "input": {
        "type": "object",
        "properties": {
          "categories": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["categories"]
      },
      "output": {
        "$ref": "#/definitions/CategoryTree"
      }
    },
    "formatIngredients": {
      "description": "Separate ingredient types from mixed array",
      "input": {
        "type": "object",
        "properties": {
          "ingredients": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["ingredients"]
      },
      "output": {
        "$ref": "#/definitions/IngredientInfo"
      }
    },
    "formatAdditives": {
      "description": "Simplify additive information for UI consumption",
      "input": {
        "type": "object",
        "properties": {
          "additiveInfo": {
            "$ref": "#/definitions/AdditiveInfo"
          },
          "additiveFlags": {
            "$ref": "#/definitions/AdditiveFlags"
          }
        }
      },
      "output": {
        "$ref": "#/definitions/AdditivesSummary"
      }
    },
    "formatNutrition": {
      "description": "Add explicit units and group nutrition data",
      "input": {
        "type": "object",
        "properties": {
          "nutrition": {
            "$ref": "#/definitions/Nutrition"
          }
        }
      },
      "output": {
        "$ref": "#/definitions/Nutrition"
      }
    }
  },
  "definitions": {
    "Product": {
      "type": "object",
      "description": "Existing Product interface from types.ts"
    },
    "UIOptimizedProduct": {
      "type": "object",
      "properties": {
        "id": { "type": ["number", "string"] },
        "name": { "type": "string" },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "categories": {
          "$ref": "#/definitions/CategoryTree"
        },
        "ingredients": {
          "$ref": "#/definitions/IngredientInfo"
        },
        "additives": {
          "$ref": "#/definitions/AdditivesSummary"
        },
        "nutrition": {
          "$ref": "#/definitions/Nutrition"
        },
        "price": {
          "$ref": "#/definitions/FixedPrice"
        }
      },
      "required": ["id", "name", "warnings"]
    },
    "CategoryTree": {
      "type": "object",
      "properties": {
        "tree": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "primary": { "type": "string" },
        "breadcrumbs": { "type": "string" },
        "depth": { "type": "number", "minimum": 1 }
      },
      "required": ["tree", "primary", "breadcrumbs", "depth"]
    },
    "IngredientInfo": {
      "type": "object",
      "properties": {
        "core": {
          "type": "array",
          "items": { "type": "string" }
        },
        "additives": {
          "type": "array",
          "items": { "type": "string" }
        },
        "nutritionalStatement": { "type": "string" },
        "allergenStatement": { "type": "string" },
        "total": { "type": "number", "minimum": 0 }
      },
      "required": ["core", "additives", "total"]
    },
    "AdditivesSummary": {
      "type": "object",
      "properties": {
        "eNumbers": {
          "type": "array",
          "items": { "type": "string", "pattern": "^E\\d{3,4}[a-z]?$" }
        },
        "summary": { "type": "string" },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dietary": {
          "type": "object",
          "properties": {
            "vegan": { "type": "boolean" },
            "vegetarian": { "type": "boolean" },
            "organic": { "type": "boolean" },
            "natural": { "type": "boolean" }
          },
          "required": ["vegan", "vegetarian", "organic", "natural"]
        },
        "categories": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["eNumbers", "summary", "warnings", "dietary", "categories"]
    },
    "Nutrition": {
      "type": "object",
      "properties": {
        "kcal": { "type": "number", "minimum": 0 },
        "kJ": { "type": "number", "minimum": 0 },
        "fat": { "type": "number", "minimum": 0 },
        "satFat": { "type": "number", "minimum": 0 },
        "carbs": { "type": "number", "minimum": 0 },
        "sugars": { "type": "number", "minimum": 0 },
        "fiber": { "type": "number", "minimum": 0 },
        "protein": { "type": "number", "minimum": 0 },
        "salt": { "type": "number", "minimum": 0 },
        "unit": { "type": "string", "enum": ["per 100g"] }
      },
      "required": ["unit"]
    },
    "FixedPrice": {
      "type": "object",
      "properties": {
        "regular": { "type": "number", "minimum": 0 },
        "sale": { "type": "number", "minimum": 0 },
        "currency": { "type": "string" }
      },
      "required": ["regular", "currency"]
    }
  },
  "testScenarios": [
    {
      "name": "Transform basic product",
      "input": {
        "product": {
          "id": "73",
          "name": "AH Franse baguettes",
          "categories": ["Bakkerij", "Afbakbrood", "Stokbrood en ciabatta"],
          "ingredients": ["tarwebloem", "water", "antioxidant (ascorbinezuur [E300])"],
          "price": { "regular": 0.75, "currency": "USD" }
        }
      },
      "expectedOutput": {
        "categories": {
          "tree": ["Bakkerij", "Afbakbrood", "Stokbrood en ciabatta"],
          "primary": "Bakkerij",
          "breadcrumbs": "Bakkerij > Afbakbrood > Stokbrood en ciabatta"
        },
        "price": {
          "currency": "EUR"
        }
      }
    },
    {
      "name": "Handle missing data gracefully",
      "input": {
        "product": {
          "id": "74",
          "name": "Test Product",
          "categories": [],
          "ingredients": null
        }
      },
      "expectedOutput": {
        "categories": {
          "tree": [],
          "primary": "",
          "breadcrumbs": ""
        },
        "ingredients": {
          "core": [],
          "additives": [],
          "total": 0
        }
      }
    }
  ]
}
