{
  "_meta": {
    "version": "gi-v1",
    "source": "Simplified synthesis of international GI tables (2002, 2008) + heuristic categories",
    "note": "Values are representative medians. Use glycemic load if portion carbohydrate grams available."
  },
  "fastCarbKeywords": [
    "glucose",
    "dextrose",
    "maltodextrin",
    "white rice",
    "jasmine rice",
    "white bread",
    "baguette",
    "rice cake",
    "corn flakes",
    "dates",
    "watermelon",
    "pretzel"
  ],
  "lowGIThreshold": 55,
  "highGIThreshold": 70,
  "defaultGI": 60,
  "categoryDefaults": {
    "fruits_low_sugar": 45,
    "fruits_high_sugar": 60,
    "dried_fruits": 65,
    "refined_grains_white_bread": 75,
    "refined_grains_rice_white": 73,
    "whole_grains": 55,
    "starchy_roots": 70,
    "legumes": 35,
    "confectionery_sugars": 80,
    "sports_drink": 85
  },
  "ingredientOverrides": {
    "glucose": 100,
    "dextrose": 100,
    "maltodextrin": 105,
    "sucrose": 65,
    "honey": 60,
    "fructose": 20,
    "dates": 75,
    "watermelon": 72,
    "banana_ripe": 62,
    "banana_green": 50
  },
  "giToMultiplier": {
    "low": 1.05,
    "medium": 1.15,
    "high": 1.3,
    "very_high": 1.4
  },
  "veryHighThreshold": 85,
  "estimationRules": [
    "If any ingredient override present use highest mapped GI",
    "Else if category matches categoryDefaults use that GI",
    "Else use defaultGI",
    "Map numeric GI -> bucket: GI < lowGIThreshold = low; < highGIThreshold = medium; < veryHighThreshold = high; else very_high",
    "Return multiplier from giToMultiplier"
  ]
}
