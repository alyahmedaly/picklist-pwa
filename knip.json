{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "project": [
    "src/**/*.{ts,tsx}",
    "tests/**/*.{ts,tsx}"
  ],
  "paths": {
    "@/*": ["./src/*"]
  },
  "ignore": [
    "out/**",
    "out-*/**",
    "dist/**",
    "storybook-static/**",
    "node_modules/.tmp/**",
    "coverage/**",
    ".temp/**",
    "specs/**/*.md",
    "specs/**/contracts/*.ts",
    "**/*.d.ts"
  ],
  "ignoreBinaries": [
    "serve",
    "sleep"
  ],
  "ignoreDependencies": [
    "@biomejs/biome",
    "shadcn",
    "tw-animate-css"
  ],
  "vite": {
    "config": ["vite.config.ts"],
    "entry": ["src/main.tsx"]
  },
  "vitest": {
    "config": ["vitest.config.ts"],
    "entry": ["tests/**/*.test.{ts,tsx}"]
  },
  "storybook": {
    "config": [".storybook/main.ts"],
    "entry": ["src/**/*.stories.@(js|jsx|mjs|ts|tsx)"]
  }
}